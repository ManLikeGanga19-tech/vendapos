{
    "name": "vendapos/core",
    "description": "Shared enums, DTOs, value objects and validation rules for VendaPOS",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "illuminate/support": "^13.0",
        "spatie/laravel-data": "^4.23"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "VendaPOS\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VendaPOS\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VendaPOS\\Core\\CoreServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}

#!/usr/bin/env sh
# Strips AI attribution from commit messages. Backstop for CLAUDE.md §6.
msg_file="$1"
tmp="$(mktemp)"

grep -viE '^[[:space:]]*(co-authored-by:.*(claude|anthropic)|claude-session:)|generated with \[?claude|🤖' "$msg_file" > "$tmp" || true

# Drop trailing blank lines left behind by removed trailers
awk 'NF{for(i=0;i<blank;i++)print "";blank=0;print;next}{blank++}' "$tmp" > "$msg_file"
rm -f "$tmp"

if [ ! -s "$msg_file" ]; then
  echo "commit-msg: message is empty after removing AI attribution" >&2
  exit 1
fi

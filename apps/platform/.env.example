APP_NAME=VendaPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vendapos
DB_USERNAME=vendapos
DB_PASSWORD=vendapos

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

OCTANE_SERVER=frankenphp

HORIZON_PREFIX=vendapos_horizon:

REVERB_APP_ID=vendapos-local
REVERB_APP_KEY=vendapos-local-key
REVERB_APP_SECRET=vendapos-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
